# Privy app id (client). Unset = demo mode with local data.
NEXT_PUBLIC_PRIVY_APP_ID=
# Privy app secret (server only, verifies sign-in tokens).
PRIVY_APP_SECRET=
# Neon Postgres connection string (server only, invite codes and profiles).
DATABASE_URL=
# SquadFactory contract address on Monad testnet. Unset = demo mode.
NEXT_PUBLIC_FACTORY=
# AjoNGN (sNGN) contract address on Monad testnet.
NEXT_PUBLIC_TOKEN=
# Private key of the relayer that settles overdue rounds (server only).
RELAYER_PRIVATE_KEY=
# Shared secret that protects the cron settle endpoint (server only).
CRON_SECRET=
# Auto-pay (docs/privy-notes.md, "Auto-pay setup"). Any unset = auto-pay hidden, cron returns 503.
# Private half of the app authorization key (server only; base64 PKCS8, "wallet-auth:" prefix is fine).
PRIVY_AUTH_PRIVATE_KEY=
# Key quorum id that holds the authorization key's public half (added as a signer on members' accounts).
NEXT_PUBLIC_PRIVY_SIGNER_ID=
# Policy id that limits that signer to contribute() with zero value on chain 10143.
NEXT_PUBLIC_PRIVY_AUTOPAY_POLICY_ID=

# Public site URL used in shared links (invites, reminders). Unset = current site.
NEXT_PUBLIC_APP_URL=

