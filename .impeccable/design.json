      "css": ".ds-row{display:flex;gap:20px;align-items:center}.ds-stamp{display:inline-grid;place-items:center;width:64px;height:64px;border:3px solid var(--stamp,#2B3CC4);border-radius:9999px;color:var(--stamp,#2B3CC4);font-family:var(--font-jetbrains),'JetBrains Mono',monospace;font-weight:500;font-size:16px;opacity:.92;-webkit-mask-image:url('/textures/ink-1.png');mask-image:url('/textures/ink-1.png');-webkit-mask-size:cover;mask-size:cover}.ds-empty{display:inline-block;width:64px;height:64px;border:1.5px dashed color-mix(in srgb,var(--muted,#6F6253) 70%,transparent);border-radius:4px}"
